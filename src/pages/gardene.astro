---
import Base from '../layouts/Base.astro';
import FarmMap from '../components/FarmMap.astro';
import { farms } from '../data/content.js';

---

<Base title="Gårdene" description="Oversikt over Spire IPT sine godkjente medlemsgårder.">
  <div class="page-head">
    <div class="container">
      <h1>Våre medlemsgårder</h1>
      <p>
        {farms.length} godkjente IPT-gårder.
        Gårdene har ulike ressurser og spesialiteter — vi hjelper deg å finne den som passer best.
      </p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      {farms.map((f) => (
        <div class="farm-row">
          <div>
            <h3><a href={`/gardene/${f.slug}`}>{f.name}</a></h3>
            {f.location && <span class="region">{f.location}</span>
            }
          </div>
          <a href={`/gardene/${f.slug}`} class="more">Les mer →</a>
        </div>
      ))}
    </div>
  </section>

  <section class="section" style="background: var(--white);">
    <div class="container">
      <h2>Kart over medlemsgårdene</h2>
      <FarmMap />
    </div>
  </section>
</Base>
