---
import Base from '../../layouts/Base.astro';
import { farms, services } from '../../data/content.js';

export function getStaticPaths() {
  return farms.map((f) => ({ params: { slug: f.slug }, props: { farm: f } }));
}

const { farm } = Astro.props;
---

<Base title={farm.name} description={farm.description}>
  <div class="page-head">
    <div class="container">
      <h1>{farm.name}</h1>
      <p>{farm.location ? farm.location + ' · ' : ''}Godkjent Inn på tunet-gård</p>
    </div>
  </div>

  <section class="section">
    <div class="container prose">
      <p><em>Beskrivelse kommer.</em></p>

      <h2>Tilbud</h2>
      <p><em>Beskrivelse kommer.</em></p>

      <h2>Dyr og ressurser</h2>
      <p><em>Beskrivelse kommer.</em></p>

      <h2>Kontakt</h2>
      <p>
        Gå direkte til
        <a href={farm.url} target="_blank" rel="noopener">{farm.name}s egen nettside ↗</a>
        for mer informasjon og kontaktmuligheter.
      </p>

      <p>
        <a href="/gardene">← Se alle medlemsgårder</a>
      </p>
    </div>
  </section>
</Base>
