---
import Base from '../layouts/Base.astro';
import { services, farms, news } from '../data/content.js';
---

<Base
  title="Trygghet og utvikling gjennom grønn omsorg"
  description="Spire IPT er et samvirke av godkjente Inn på tunet-gårder som tilbyr tilrettelagte tjenester innen læring, arbeid, omsorg og fritid."
>
  <section class="hero">
    <div class="container">
      <h1>Trygghet og utvikling gjennom grønn omsorg</h1>
      <p>
        Spire er et samvirke av godkjente Inn på tunet-gårder. Vi tilbyr kommuner og etater
        dokumenterte, gårdsbaserte tjenester innen læring, arbeid, omsorg og fritid — med
        gården, dyrene og naturen som arena.
      </p>
      <a href="/gardene" class="btn">Finn riktig gård</a>
      <a href="/for-kommuner" class="btn btn-outline">For kommuner og etater</a>
    </div>
  </section>

  <section class="section intro">
    <div class="container">
      <h2>Gården som virkemiddel — ikke bare opplevelse</h2>
      <p>
        Forskning på grønn omsorg viser positive effekter på psykisk helse, mestring,
        arbeidsevne og livskvalitet. For kommuner og etater er IPT et tidlig, forebyggende
        og nært tiltak som utfyller egne tjenester.
      </p>
      <p>
        <a href="/hvorfor-gardsbaserte-tjenester" class="more">Se hva forskningen viser →</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Våre tjenester</h2>
      <ul class="cards">
        {services.map((s) => (
          <li class="card">
            <h3>{s.title}</h3>
            <p>{s.short}</p>
            <a href={`/tjenester/${s.slug}`} class="more">Les mer →</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" style="background: var(--white);">
    <div class="container">
      <h2>Våre {farms.length} medlemsgårder</h2>
      {farms.map((f) => (
        <div class="farm-row">
          <div>
            <h3><a href={`/gardene/${f.slug}`}>{f.name}</a></h3>
            {f.location && <span class="region">{f.location}</span>}
          </div>
          <a href={`/gardene/${f.slug}`} class="more">Les mer →</a>
          <span class="desc">{f.description}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section" style="background: var(--blue-100);">
    <div class="container">
      <h2>Nyheter</h2>
      <ul class="cards">
        {news.map((n) => (
          <li class="card">
            <span class="date">{n.date}</span>
            <h3>{n.title}</h3>
            <p>{n.excerpt}</p>
            <a href={`/nyheter/${n.slug}`} class="more">Les mer →</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

</Base>
