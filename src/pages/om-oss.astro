---
import Base from '../layouts/Base.astro';
import { contactPersons } from '../data/content.js';
---

<Base title="Om oss" description="Spire IPT er et samvirke av godkjente Inn på tunet-gårder, etablert i 2023.">
  <div class="page-head">
    <div class="container">
      <h1>Om Spire IPT</h1>
      <p>Samvirke av godkjente Inn på tunet-gårder — etablert i 2023.</p>
    </div>
  </div>

  <section class="section">
    <div class="container prose">
      <p>
        Spire IPT er et samvirke av godkjente Inn på tunet-gårder som bruker gårdens
        ressurser til å skape meningsfulle tilbud for mennesker i ulike aldre og
        livssituasjoner. Hos oss står mestring, tilhørighet, aktivitet og gode relasjoner
        i sentrum.
      </p>
      <p>
        Samvirket ble etablert i 2023. Gårdene har ulike ressurser — fra fjellgårder med sau til
        alpakkaer og rideskole — men felles fokus på å møte det enkelte mennesket med
        respekt, trygghet og tro på egne muligheter.
      </p>
      <h2>Styret</h2>
    </div>
    <div class="container" style="margin-top: 1rem;">
      <ul class="contact-list">
        {contactPersons.map((p) => (
          <li class="contact-card">
            <h3>{p.name}</h3>
            <p class="role">{p.role}</p>
            <a href={`mailto:${p.email}`}>{p.email}</a>
            <a href={`tel:${p.phone.replace(/\s/g, '')}`}>{p.phone}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
